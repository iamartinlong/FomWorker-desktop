{
  "name": "@fominfo/dsh-bundle-fomworker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FomWorker profile bundle：把 FomWorker 品牌 occupant + 办公平台插件（catalog/authz/console）作为一层 patch 挂进 dsh profile（替代手工 profile 行）。",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml"
  ],
  "dependencies": {
    "@fominfo/dsh-client-ui-brand-fomworker": "*",
    "@fominfo/dsh-client-ui-login": "*",
    "@office/approval": "*",
    "@office/assistant": "*",
    "@office/authz": "*",
    "@office/billing": "*",
    "@office/catalog": "*",
    "@office/channel": "*",
    "@office/console": "*",
    "@office/delegate": "*",
    "@office/experts": "*",
    "@office/feishu": "*",
    "@office/reporter": "*",
    "@office/skills": "*",
    "@office/tasks": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
