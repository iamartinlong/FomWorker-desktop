{
  "name": "@office/billing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "office-billing：自建价格表折算 + 限额裁决 + 本地配额执行（拉 /config/quota，预检/展示，不硬拦）+ 设置页「用量与配额」。",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.ts",
    "pricing.ts",
    "quota.ts",
    "platform.ts",
    "src/client/*",
    "lib/index.js",
    "lib/client.js"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "bundle": "tsdown"
  },
  "devDependencies": {
    "tsdown": "^0.22.2",
    "@types/react": "~18.3.1",
    "react": "^18.3.1"
  }
}
